# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database Configuration
DATABASE_URL="file:./data/iwacu_kids.db"

# MongoDB Atlas connection (SRV). Some networks block `+srv` DNS lookups; then
# MONGODB_MIRROR_URI (explicit replica-set host:port list) is used as fallback.
MONGODB_URI="mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/iwacukids?appName=Cluster0"
MONGODB_MIRROR_URI="mongodb://user:pass@shard-00-00.xxxxx.mongodb.net:27017,shard-00-01.xxxxx.mongodb.net:27017,shard-00-02.xxxxx.mongodb.net:27017/?replicaSet=atlas-xxxxx-shard-0&ssl=true&retryWrites=true&w=majority&authSource=admin"

# JWT Authentication Secret for Admin/Staff Sessions
JWT_SECRET="iwacu-kids-super-secret-jwt-key-2026"

# MTN MoMo Rwanda Collection API Configuration
MTN_MOMO_API_URL="https://sandbox.momodeveloper.mtn.com/collection/v1_0"
MTN_MOMO_API_KEY=""
MTN_MOMO_SECRET=""
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_ENVIRONMENT="sandbox"

# Airtel Money Rwanda API Configuration
AIRTEL_API_URL="https://openapiuat.airtel.africa"
AIRTEL_CLIENT_ID=""
AIRTEL_CLIENT_SECRET=""

# Cloud Object Storage (Cloudflare R2 / S3 compatible)
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="iwacu-kids-assets"

# Application URLs
FRONTEND_URL="http://localhost:3000"
API_URL="http://localhost:3000/api"

