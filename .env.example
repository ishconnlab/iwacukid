# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database Configuration
DATABASE_URL="file:./data/iwacu_kids.db"

# JWT Authentication Secret for Admin/Staff Sessions
JWT_SECRET="iwacu-kids-super-secret-jwt-key-2026"

# MTN MoMo Rwanda Collection API Configuration
MTN_MOMO_API_URL="https://sandbox.momodeveloper.mtn.com/collection/v1_0"
MTN_MOMO_API_KEY=""
MTN_MOMO_SECRET=""
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_ENVIRONMENT="sandbox"

# Airtel Money Rwanda API Configuration
AIRTEL_API_URL="https://openapiuat.airtel.africa"
AIRTEL_CLIENT_ID=""
