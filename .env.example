# Cloud Object Storage (Cloudflare R2 / S3 compatible)
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="iwacu-kids-assets"

# Application URLs
FRONTEND_URL="http://localhost:3000"
API_URL="http://localhost:3000/api"

